{
  "manifest_version": 3,
  "name": "Revisor de mensagens do Slack",
  "description": "Revisa sua mensagem no Slack com o Claude Code local antes de enviar.",
  "version": "0.2.1",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "alarms"],
  "host_permissions": ["https://app.slack.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://app.slack.com/*"],
      "js": ["selectors.js", "diff.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Revisor de mensagens do Slack",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
